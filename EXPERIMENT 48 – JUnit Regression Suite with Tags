import org.junit.jupiter.api.*;
import org.junit.platform.suite.api.*;
import static org.junit.jupiter.api.Assertions.*;

/*
 * Experiment 48 - Create a regression test suite using tags and test suites
 * in JUnit (JUnit)
 * Dependency for @Suite: org.junit.platform:junit-platform-suite
 * Run only regression tests:  mvn test -Dgroups=regression
 */
class ShoppingCart {
    private double total = 0;
    private int items = 0;
    void add(double price) {
        if (price <= 0) throw new IllegalArgumentException("Invalid price");
        total += price;
        items++;
    }
    double applyDiscount(int percent) { return total - total * percent / 100.0; }
    double getTotal() { return total; }
    int getItems() { return items; }
}

class CartTests {

    ShoppingCart cart;

    @BeforeEach
    void setUp() { cart = new ShoppingCart(); }

    @Test @Tag("smoke") @Tag("regression")
    void addSingleItem() {
        cart.add(100);
        assertEquals(1, cart.getItems());
    }

    @Test @Tag("regression")
    void totalOfMultipleItems() {
        cart.add(100);
        cart.add(250.5);
        assertEquals(350.5, cart.getTotal());
    }

    @Test @Tag("regression")
    void discountApplied() {
        cart.add(1000);
        assertEquals(900, cart.applyDiscount(10));
    }

    @Test @Tag("regression") @Tag("negative")
    void invalidPriceRejected() {
        assertThrows(IllegalArgumentException.class, () -> cart.add(-5));
    }

    @Test @Tag("slow")
    void manyItems() {
        for (int i = 0; i < 10000; i++) cart.add(1);
        assertEquals(10000, cart.getItems());
    }
}

@Suite
@SuiteDisplayName("Regression Test Suite")
@SelectClasses(CartTests.class)
@IncludeTags("regression")
@ExcludeTags("slow")
public class RegressionSuite {
}
