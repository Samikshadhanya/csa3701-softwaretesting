import org.junit.jupiter.api.*;
import org.openqa.selenium.*;
import org.openqa.selenium.chrome.ChromeDriver;
import static org.junit.jupiter.api.Assertions.*;
import java.io.File;
import java.nio.file.*;
import java.text.SimpleDateFormat;
import java.util.Date;

/*
 * Experiment 15 - Capture a screenshot of a web page and store it in the local
 * system using Selenium WebDriver (Selenium)
 */
public class ScreenshotTest {

    WebDriver driver;

    @BeforeEach
    void setUp() {
        driver = new ChromeDriver();
        driver.manage().window().maximize();
    }

    String capture(String name) throws Exception {
        String time = new SimpleDateFormat("yyyyMMdd_HHmmss").format(new Date());
        File src = ((TakesScreenshot) driver).getScreenshotAs(OutputType.FILE);
        Path dest = Paths.get("screenshots", name + "_" + time + ".png");
        Files.createDirectories(dest.getParent());
        Files.copy(src.toPath(), dest, StandardCopyOption.REPLACE_EXISTING);
        System.out.println("Screenshot saved: " + dest.toAbsolutePath());
        return dest.toString();
    }

    @Test
    void captureFullPage() throws Exception {
        driver.get("https://the-internet.herokuapp.com/");
        String path = capture("homepage");
        assertTrue(new File(path).exists());
        assertTrue(new File(path).length() > 0);
    }

    @Test
    void captureSingleElement() throws Exception {
        driver.get("https://the-internet.herokuapp.com/login");
        WebElement form = driver.findElement(By.id("login"));
        File src = form.getScreenshotAs(OutputType.FILE);
        Path dest = Paths.get("screenshots", "login_form.png");
        Files.createDirectories(dest.getParent());
        Files.copy(src.toPath(), dest, StandardCopyOption.REPLACE_EXISTING);
        assertTrue(Files.exists(dest));
    }

    @AfterEach
    void tearDown() {
        driver.quit();
    }
}
