import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

/*
 * Experiment 28 - Implement white-box testing using statement coverage on a
 * number sorting program using JUnit (JUnit)
 * Every statement of bubbleSort() is executed by at least one test.
 * Check coverage with: mvn test jacoco:report (or IntelliJ "Run with Coverage")
 */
class NumberSorter {
    static int[] bubbleSort(int[] arr) {
        if (arr == null) {                       // S1
            return new int[0];                   // S2
        }
        int[] a = arr.clone();                   // S3
        int n = a.length;                        // S4
        for (int i = 0; i < n - 1; i++) {        // S5
            for (int j = 0; j < n - 1 - i; j++) {// S6
                if (a[j] > a[j + 1]) {           // S7
                    int temp = a[j];             // S8
                    a[j] = a[j + 1];             // S9
                    a[j + 1] = temp;             // S10
                }
            }
        }
        return a;                                // S11
    }
}

public class NumberSorterStatementCoverageTest {

    @Test
    void nullArrayCoversS1S2() {
        assertArrayEquals(new int[0], NumberSorter.bubbleSort(null));
    }

    @Test
    void unsortedArrayCoversSwapStatements() {
        assertArrayEquals(new int[]{1, 2, 5, 8, 9},
                NumberSorter.bubbleSort(new int[]{5, 1, 9, 2, 8}));
    }

    @Test
    void alreadySortedArray() {
        assertArrayEquals(new int[]{1, 2, 3}, NumberSorter.bubbleSort(new int[]{1, 2, 3}));
    }

    @Test
    void singleElement() {
        assertArrayEquals(new int[]{7}, NumberSorter.bubbleSort(new int[]{7}));
    }

    @Test
    void negativeAndDuplicateNumbers() {
        assertArrayEquals(new int[]{-3, 0, 2, 2}, NumberSorter.bubbleSort(new int[]{2, -3, 2, 0}));
    }
}
