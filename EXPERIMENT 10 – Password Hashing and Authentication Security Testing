import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.SecureRandom;
import java.util.*;

/*
 * Experiment 10 - Implement security testing for password hashing and
 * authentication using JUnit (JUnit)
 */
class AuthService {
    private final Map<String, String[]> users = new HashMap<>();   // user -> {salt, hash}
    private final Map<String, Integer> failedAttempts = new HashMap<>();

    static String hash(String password, String salt) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-256");
            byte[] digest = md.digest((salt + password).getBytes(StandardCharsets.UTF_8));
            return Base64.getEncoder().encodeToString(digest);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    static String newSalt() {
        byte[] b = new byte[16];
        new SecureRandom().nextBytes(b);
        return Base64.getEncoder().encodeToString(b);
    }

    void register(String user, String password) {
        if (password.length() < 8) throw new IllegalArgumentException("Weak password");
        String salt = newSalt();
        users.put(user, new String[]{salt, hash(password, salt)});
    }

    String storedHash(String user) { return users.get(user)[1]; }

    boolean login(String user, String password) {
        if (failedAttempts.getOrDefault(user, 0) >= 3) return false;   // account locked
        String[] rec = users.get(user);
        boolean ok = rec != null && rec[1].equals(hash(password, rec[0]));
        if (!ok) failedAttempts.merge(user, 1, Integer::sum);
        else failedAttempts.put(user, 0);
        return ok;
    }
}

public class AuthServiceSecurityTest {

    @Test
    void testPasswordNotStoredInPlainText() {
        AuthService a = new AuthService();
        a.register("alice", "Secret@123");
        assertNotEquals("Secret@123", a.storedHash("alice"));
    }

    @Test
    void testSamePasswordDifferentHashDueToSalt() {
        AuthService a = new AuthService();
        a.register("u1", "Common@123");
        a.register("u2", "Common@123");
        assertNotEquals(a.storedHash("u1"), a.storedHash("u2"));
    }

    @Test
    void testValidLogin() {
        AuthService a = new AuthService();
        a.register("bob", "Strong#Pass1");
        assertTrue(a.login("bob", "Strong#Pass1"));
    }

    @Test
    void testInvalidLogin() {
        AuthService a = new AuthService();
        a.register("bob", "Strong#Pass1");
        assertFalse(a.login("bob", "wrongpass"));
    }

    @Test
    void testSqlInjectionStringRejected() {
        AuthService a = new AuthService();
        a.register("admin", "Admin@2024");
        assertFalse(a.login("admin", "' OR '1'='1"));
    }

    @Test
    void testAccountLockAfterThreeFailures() {
        AuthService a = new AuthService();
        a.register("carl", "Carl@12345");
        a.login("carl", "x"); a.login("carl", "y"); a.login("carl", "z");
        assertFalse(a.login("carl", "Carl@12345"));
    }

    @Test
    void testWeakPasswordRejected() {
        AuthService a = new AuthService();
        assertThrows(IllegalArgumentException.class, () -> a.register("dan", "123"));
    }
}
