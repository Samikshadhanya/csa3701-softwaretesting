import java.util.*;

/*
 * Experiment 3 - Create a defect report for a web-based form submission application (Manual)
 */
public class WebFormDefectReport {

    static class Defect {
        String id, title, steps, expected, actual, severity, priority, status;
        Defect(String id, String title, String steps, String expected, String actual,
               String severity, String priority) {
            this.id = id; this.title = title; this.steps = steps; this.expected = expected;
            this.actual = actual; this.severity = severity; this.priority = priority; this.status = "Open";
        }
        void print() {
            System.out.println("Defect ID     : " + id);
            System.out.println("Title         : " + title);
            System.out.println("Module        : Registration Form");
            System.out.println("Environment   : Chrome 120, Windows 11");
            System.out.println("Steps         : " + steps);
            System.out.println("Expected      : " + expected);
            System.out.println("Actual        : " + actual);
            System.out.println("Severity      : " + severity + "   Priority: " + priority);
            System.out.println("Status        : " + status);
            System.out.println("------------------------------------------------------------");
        }
    }

    // Simple validation logic of the form under test (with defects)
    static boolean validEmail(String e) { return e.contains("@"); }          // "a@" passes
    static boolean validPhone(String p) { return p.length() == 10; }        // letters allowed
    static boolean validPassword(String p) { return p.length() >= 4; }      // spec says 8

    public static void main(String[] args) {
        System.out.println("WEB FORM - DEFECT REPORT\n");
        List<Defect> defects = new ArrayList<>();

        if (validEmail("user@"))
            defects.add(new Defect("WF-01", "Invalid email accepted",
                "1. Open form 2. Enter email 'user@' 3. Submit",
                "Error 'Invalid email'", "Form submitted", "Major", "High"));
        if (validPhone("98765abcde"))
            defects.add(new Defect("WF-02", "Phone field accepts letters",
                "1. Enter phone '98765abcde' 2. Submit",
                "Only digits allowed", "Form submitted", "Major", "Medium"));
        if (validPassword("abcd"))
            defects.add(new Defect("WF-03", "Password shorter than 8 chars accepted",
                "1. Enter password 'abcd' 2. Submit",
                "Minimum 8 characters error", "Form submitted", "Critical", "High"));

        for (Defect d : defects) d.print();
        System.out.println("Total defects reported: " + defects.size());
    }
}
