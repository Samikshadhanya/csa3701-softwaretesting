import org.junit.jupiter.api.*;
import org.openqa.selenium.*;
import org.openqa.selenium.chrome.ChromeDriver;
import static org.junit.jupiter.api.Assertions.*;
import org.openqa.selenium.support.ui.*;
import java.time.Duration;

/*
 * Experiment 52 - Execute system testing of an end-to-end checkout flow
 * using Selenium WebDriver (Selenium)
 * Application: https://www.saucedemo.com  (standard_user / secret_sauce)
 */
public class CheckoutFlowTest {

    WebDriver driver;
    WebDriverWait wait;

    @BeforeEach
    void setUp() {
        driver = new ChromeDriver();
        wait = new WebDriverWait(driver, Duration.ofSeconds(10));
        driver.get("https://www.saucedemo.com/");
        driver.findElement(By.id("user-name")).sendKeys("standard_user");
        driver.findElement(By.id("password")).sendKeys("secret_sauce");
        driver.findElement(By.id("login-button")).click();
    }

    @Test
    void endToEndCheckout() {
        // 1. Product listing
        assertEquals("Products", driver.findElement(By.className("title")).getText());

        // 2. Add items to cart
        driver.findElement(By.id("add-to-cart-sauce-labs-backpack")).click();
        driver.findElement(By.id("add-to-cart-sauce-labs-bike-light")).click();
        assertEquals("2", driver.findElement(By.className("shopping_cart_badge")).getText());

        // 3. Cart
        driver.findElement(By.className("shopping_cart_link")).click();
        assertEquals(2, driver.findElements(By.className("cart_item")).size());

        // 4. Checkout information
        driver.findElement(By.id("checkout")).click();
        driver.findElement(By.id("first-name")).sendKeys("Samiksha");
        driver.findElement(By.id("last-name")).sendKeys("D");
        driver.findElement(By.id("postal-code")).sendKeys("600001");
        driver.findElement(By.id("continue")).click();

        // 5. Overview - verify item total
        String itemTotal = driver.findElement(By.className("summary_subtotal_label")).getText();
        assertTrue(itemTotal.contains("39.98"));

        // 6. Finish
        driver.findElement(By.id("finish")).click();
        WebElement header = wait.until(ExpectedConditions.visibilityOfElementLocated(By.className("complete-header")));
        assertEquals("Thank you for your order!", header.getText());
    }

    @Test
    void checkoutWithoutDetailsShowsError() {
        driver.findElement(By.id("add-to-cart-sauce-labs-backpack")).click();
        driver.findElement(By.className("shopping_cart_link")).click();
        driver.findElement(By.id("checkout")).click();
        driver.findElement(By.id("continue")).click();
        String error = driver.findElement(By.cssSelector("[data-test='error']")).getText();
        assertTrue(error.contains("First Name is required"));
    }

    @AfterEach
    void tearDown() {
        driver.quit();
    }
}
