import org.junit.jupiter.api.*;
import java.util.EmptyStackException;
import java.util.Stack;
import static org.junit.jupiter.api.Assertions.*;

/*
 * Experiment 49 - Demonstrate the JUnit test life cycle using a stack
 * implementation (JUnit)
 * Order: @BeforeAll -> (@BeforeEach -> @Test -> @AfterEach) x n -> @AfterAll
 */
@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
public class StackLifeCycleTest {

    Stack<Integer> stack;

    @BeforeAll
    static void beforeAll() {
        System.out.println("@BeforeAll  : runs once before all tests");
    }

    @BeforeEach
    void beforeEach(TestInfo info) {
        stack = new Stack<>();
        System.out.println("  @BeforeEach : new empty stack for " + info.getDisplayName());
    }

    @Test @Order(1)
    void pushElement() {
        stack.push(10);
        assertEquals(1, stack.size());
        System.out.println("    @Test push");
    }

    @Test @Order(2)
    void popElement() {
        stack.push(10);
        stack.push(20);
        assertEquals(20, (int) stack.pop());
        System.out.println("    @Test pop");
    }

    @Test @Order(3)
    void peekElement() {
        stack.push(5);
        assertEquals(5, (int) stack.peek());
        assertEquals(1, stack.size());
        System.out.println("    @Test peek");
    }

    @Test @Order(4)
    void popEmptyStack() {
        assertThrows(EmptyStackException.class, () -> stack.pop());
        System.out.println("    @Test pop on empty stack");
    }

    @Test @Order(5)
    void isEmptyInitially() {
        assertTrue(stack.isEmpty());
        System.out.println("    @Test isEmpty");
    }

    @AfterEach
    void afterEach() {
        stack.clear();
        System.out.println("  @AfterEach  : stack cleared");
    }

    @AfterAll
    static void afterAll() {
        System.out.println("@AfterAll   : runs once after all tests");
    }
}
